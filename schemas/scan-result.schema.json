{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matteoredaelli/open-web-fingerprints/schemas/scan-result.schema.json",
  "title": "Open Web Fingerprints scan result",
  "description": "What was observed on one target. Draft v0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scanned_at",
    "scanner",
    "target",
    "pages",
    "technologies",
    "links",
    "domains",
    "socials",
    "contacts",
    "coverage",
    "registry",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "scanner": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "url",
        "host"
      ],
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "registrable_domain": {
          "type": "string"
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "technologies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/technology"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "socials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/social"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sha256",
        "schema_version",
        "sources"
      ],
      "properties": {
        "content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema_version": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notice": {
          "type": "string"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value",
          "found"
        ],
        "properties": {
          "kind": {
            "enum": [
              "email",
              "phone"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "found": {
            "$ref": "#/$defs/found"
          }
        }
      }
    },
    "friends": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present only when friend detection was asked for. A friend is a domain that the target's home page links to and whose own home page links back. It says what two home pages link to, no more.",
      "required": [
        "candidates",
        "checked",
        "domains"
      ],
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0,
          "description": "External domains the home page links to, social platforms left out."
        },
        "checked": {
          "type": "integer",
          "minimum": 0
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "status",
              "linked_from"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "friend",
                  "not_friend",
                  "not_allowed",
                  "unreachable",
                  "not_checked"
                ]
              },
              "url": {
                "type": "string"
              },
              "linked_from": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "links_back": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present only when the first page was also run in a headless browser. Then the page's global variables and XHR calls are known, and the first page's HTML, links, socials and contacts are those of the document after its scripts ran.",
      "required": [
        "requests",
        "blocked",
        "globals_found"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "requests": {
          "type": "integer",
          "minimum": 0,
          "description": "Requests the page made through the scanner's proxy."
        },
        "blocked": {
          "type": "integer",
          "minimum": 0,
          "description": "Connections the proxy refused (non-public addresses)."
        },
        "timed_out": {
          "type": "boolean"
        },
        "globals_found": {
          "type": "integer",
          "minimum": 0,
          "description": "How many of the global variables looked for exist on the page."
        }
      }
    },
    "suppressed": {
      "type": "array",
      "description": "Technologies that a rule matched but that are not reported: the registry says another detected technology excludes them, or something they need is missing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "reason",
          "by",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "excluded",
              "requirement_not_met"
            ]
          },
          "by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "active": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present only when probes were allowed. Probes are requests to paths of the scanned site that a reviewer approved.",
      "required": [
        "approved",
        "sent",
        "failed",
        "not_sent",
        "disallowed",
        "refused"
      ],
      "properties": {
        "approved": {
          "type": "integer",
          "minimum": 0
        },
        "sent": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "not_sent": {
          "type": "integer",
          "minimum": 0
        },
        "disallowed": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present only when related domains were asked for. Domains that may belong to the same owner, with what ties each to the target. Never a statement of ownership.",
      "required": [
        "candidates",
        "checked",
        "domains"
      ],
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "checked": {
          "type": "integer",
          "minimum": 0
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "level",
              "status",
              "evidence"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "enum": [
                  "probable",
                  "candidate"
                ]
              },
              "status": {
                "enum": [
                  "checked",
                  "not_allowed",
                  "unreachable",
                  "not_checked"
                ]
              },
              "url": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "strength"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "linked_from_home",
                        "links_back",
                        "hreflang_home",
                        "hreflang_back",
                        "cert_san",
                        "cert_org",
                        "site_verification",
                        "analytics_id",
                        "redirects_to_target",
                        "name_variant"
                      ]
                    },
                    "strength": {
                      "enum": [
                        "strong",
                        "medium",
                        "weak"
                      ]
                    },
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "variants_tried": {
          "type": "integer",
          "minimum": 0
        },
        "variants_resolved": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "final_url",
        "status",
        "bytes",
        "duration_ms"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "final_url": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "content_type": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "redirects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "status"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "integer"
              }
            }
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cached": {
          "type": "boolean"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "ips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "version": {
              "type": "string"
            },
            "issuer": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "not_before": {
              "type": "string",
              "format": "date-time"
            },
            "not_after": {
              "type": "string",
              "format": "date-time"
            },
            "dns_names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "confidence",
        "sources",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tech_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "same_name": {
          "type": "array",
          "description": "IDs of other registry records with the same name, detected too and shown here as one. The registry keeps them apart until a reviewer merges them; this is presentation only.",
          "items": {
            "type": "string",
            "pattern": "^tech_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "observation",
        "health",
        "source"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^fp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "observation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "target": {
          "type": "string"
        },
        "matched": {
          "type": "string",
          "maxLength": 300
        },
        "version": {
          "type": "string"
        },
        "health": {
          "enum": [
            "unknown",
            "ok",
            "degraded",
            "broken"
          ]
        },
        "source": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "page": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "kind",
        "internal",
        "domain",
        "found_in"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "a",
            "link",
            "script",
            "iframe",
            "form",
            "img",
            "source"
          ]
        },
        "rel": {
          "type": "string"
        },
        "internal": {
          "type": "boolean"
        },
        "domain": {
          "type": "string"
        },
        "found_in": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "internal",
        "links"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "internal": {
          "type": "boolean"
        },
        "links": {
          "type": "integer",
          "minimum": 1
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "handle",
        "url",
        "found"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "kind": {
          "type": "string"
        },
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "found": {
          "$ref": "#/$defs/found"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules_total",
        "rules_evaluated",
        "rules_unsupported"
      ],
      "properties": {
        "rules_total": {
          "type": "integer",
          "minimum": 0
        },
        "rules_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "rules_unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "found": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "via"
        ],
        "properties": {
          "page": {
            "type": "string",
            "minLength": 1
          },
          "via": {
            "enum": [
              "a",
              "meta",
              "jsonld",
              "rel-me",
              "link",
              "text"
            ]
          }
        }
      }
    }
  }
}
