{
 "schema_version": "0.1.0",
 "cases": [
  {
   "id": "metatag-cms-positive",
   "description": "Upstream's rule matches ANY page that declares a generator, whatever the product: a Hugo site is reported as 'Metatag CMS'. Documents the rule's real behaviour; it does not say the page uses a CMS called Metatag.",
   "group": [
    {
     "technology": "metatag-cms",
     "observation": "response_headers",
     "operator": "contains",
     "pattern": "text/html"
    },
    {
     "technology": "metatag-cms",
     "observation": "html",
     "operator": "regex",
     "pattern": "(?-i)(?i)<meta\\s+?name=\"?generator\"?\\s+?content=\"[^\"]+?\""
    }
   ],
   "input": {
    "status": 200,
    "headers": {
     "Content-Type": "text/html; charset=utf-8"
    },
    "html": "<html><head><meta name=\"generator\" content=\"Hugo 0.119.0\"></head></html>"
   },
   "expect": {
    "match": true
   }
  },
  {
   "id": "metatag-cms-negative-no-generator",
   "description": "Without a generator meta tag the group does not hold.",
   "group": [
    {
     "technology": "metatag-cms",
     "observation": "response_headers",
     "operator": "contains",
     "pattern": "text/html"
    },
    {
     "technology": "metatag-cms",
     "observation": "html",
     "operator": "regex",
     "pattern": "(?-i)(?i)<meta\\s+?name=\"?generator\"?\\s+?content=\"[^\"]+?\""
    }
   ],
   "input": {
    "status": 200,
    "headers": {
     "Content-Type": "text/html"
    },
    "html": "<html><head><title>Plain</title></head></html>"
   },
   "expect": {
    "match": false
   }
  },
  {
   "id": "metatag-cms-negative-not-html",
   "description": "Both members are needed: the content type must be html.",
   "group": [
    {
     "technology": "metatag-cms",
     "observation": "response_headers",
     "operator": "contains",
     "pattern": "text/html"
    },
    {
     "technology": "metatag-cms",
     "observation": "html",
     "operator": "regex",
     "pattern": "(?-i)(?i)<meta\\s+?name=\"?generator\"?\\s+?content=\"[^\"]+?\""
    }
   ],
   "input": {
    "status": 200,
    "headers": {
     "Content-Type": "application/json"
    },
    "html": "<meta name=\"generator\" content=\"X\">"
   },
   "expect": {
    "match": false
   }
  },
