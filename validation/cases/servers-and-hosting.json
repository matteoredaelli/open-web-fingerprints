{
  "schema_version": "0.1.0",
  "cases": [
    {
      "id": "apache-http-server-http-header-1-positive",
      "rule": {
        "technology": "apache-http-server",
        "observation": "http_header",
        "target": "Server",
        "pattern": "(?:Apache(?:$|/([\\d.]+)|[^/-])|(?:^|\\b)HTTPD)",
        "operator": "regex"
      },
      "input": {
        "headers": {
          "Server": "Apache/2.4.58 (Ubuntu)"
        }
      },
      "expect": {
        "match": true,
        "version": "2.4.58"
      }
    },
    {
      "id": "apache-http-server-http-header-1-negative",
