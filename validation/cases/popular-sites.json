        "observation": "http_header",
        "target": "Server",
        "operator": "regex",
        "pattern": "^envoy$"
      },
      "input": {
        "headers": {
          "Server": "envoy-proxy-lite"
        }
      },
      "expect": {
        "match": false
      }
    },
