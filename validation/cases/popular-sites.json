  "schema_version": "0.1.0",
  "cases": [
    {
      "id": "envoy-server-header-positive",
      "rule": {
        "technology": "envoy",
        "observation": "http_header",
        "target": "Server",
        "operator": "regex",
        "pattern": "^envoy$"
      },
      "input": {
        "headers": {
          "Server": "envoy"
        }
      },
      "expect": {
        "match": true
      }
    },
    {
      "id": "envoy-server-header-negative",
      "description": "The rule is anchored: a longer product name is not Envoy.",
      "rule": {
