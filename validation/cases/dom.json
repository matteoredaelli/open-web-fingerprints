{
  "schema_version": "0.1.0",
  "cases": [
    {
      "id": "wordpress-dom-stylesheet-positive",
      "rule": {"technology": "wordpress", "observation": "dom", "target": "link[rel=stylesheet][href*='/wp-content/']"},
      "input": {"html": "<head><link rel=\"stylesheet\" href=\"/wp-content/themes/x/style.css\"></head>"},
      "expect": {"match": true}
    },
    {
      "id": "wordpress-dom-stylesheet-negative",
      "description": "A preload link is not a stylesheet.",
      "rule": {"technology": "wordpress", "observation": "dom", "target": "link[rel=stylesheet][href*='/wp-content/']"},
      "input": {"html": "<head><link rel=\"preload\" href=\"/wp-content/themes/x/font.woff2\"><link rel=\"stylesheet\" href=\"/static/site.css\"></head>"},
      "expect": {"match": false}
    },
    {
      "id": "wordpress-dom-blocks-positive",
      "rule": {"technology": "wordpress", "observation": "dom", "target": "div[class*='wp-block-group'] > div[class*='wp-block-']"},
      "input": {"html": "<div class=\"wp-block-group\"><div class=\"wp-block-columns\">x</div></div>"},
      "expect": {"match": true}
    },
    {
      "id": "wordpress-dom-blocks-negative",
      "description": "The child combinator matters: a nested block two levels down does not count.",
      "rule": {"technology": "wordpress", "observation": "dom", "target": "div[class*='wp-block-group'] > div[class*='wp-block-']"},
      "input": {"html": "<div class=\"wp-block-group\"><section><div class=\"wp-block-columns\">x</div></section></div>"},
      "expect": {"match": false}
    },
    {
      "id": "pixelfed-version-positive",
      "rule": {"technology": "pixelfed", "observation": "dom", "target": "a[href='pixelfed.org'][title*='version']::attr(title)"},
      "input": {"html": "<a href=\"pixelfed.org\" title=\"version 0.11.9\">Pixelfed</a>"},
      "expect": {"match": true, "version": "0.11.9"}
    },
    {
      "id": "pixelfed-version-negative",
      "rule": {"technology": "pixelfed", "observation": "dom", "target": "a[href='pixelfed.org'][title*='version']::attr(title)"},
      "input": {"html": "<a href=\"https://example.org\" title=\"version 0.11.9\">Other</a>"},
      "expect": {"match": false}
    },
    {
      "id": "pixelfed-text-positive",
      "rule": {"technology": "pixelfed", "observation": "dom", "target": "a[href='pixelfed.org'][title*='version']::text"},
      "input": {"html": "<a href=\"pixelfed.org\" title=\"version 1.0\">Powered by Pixelfed</a>"},
      "expect": {"match": true}
    },
    {
      "id": "pixelfed-text-negative",
      "description": "The text rule is anchored.",
      "rule": {"technology": "pixelfed", "observation": "dom", "target": "a[href='pixelfed.org'][title*='version']::text"},
      "input": {"html": "<a href=\"pixelfed.org\" title=\"version 1.0\">Not powered by Pixelfed at all</a>"},
      "expect": {"match": false}
    },
    {
      "id": "bootstrap-cdn-version-positive",
      "rule": {"technology": "bootstrap", "observation": "dom", "target": "link[href*=\"cdn.jsdelivr.net/npm/bootstrap\"]::attr(href)"},
      "input": {"html": "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css\">"},
      "expect": {"match": true}
    },
    {
      "id": "bootstrap-cdn-negative",
      "rule": {"technology": "bootstrap", "observation": "dom", "target": "link[href*=\"cdn.jsdelivr.net/npm/bootstrap\"]::attr(href)"},
      "input": {"html": "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/animate.css@4/animate.min.css\">"},
      "expect": {"match": false}
    }
  ]
}
